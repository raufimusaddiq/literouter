{
  "name": "literouter",
  "version": "1.0.1",
  "description": "LiteRouter CLI - Start and manage LiteRouter server",
  "bin": {
    "literouter": "./cli.js"
  },
  "files": [
    "cli.js",
    "src",
    "hooks",
    "app",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch cli.js",
    "build": "bun scripts/build-cli.js",
    "test": "bun test",
    "pack:cli": "bun run build && bun pm pack --destination ..",
    "publish:cli": "bun run build && bun publish",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "keywords": [
    "literouter",
    "cli",
    "proxy",
    "ai",
    "api"
  ],
  "license": "MIT"
}
