# LiteRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/literouter

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Interface the server binds to (default 0.0.0.0). Set 127.0.0.1 to listen on loopback only.
# HOSTNAME=0.0.0.0
# Set to 1 to replace the runtime's bundled CA roots with the OS store at startup (the Docker image sets it). The server refuses to start if the store is empty.
# LITEROUTER_SYSTEM_CA=1
# Directory holding a prebuilt dashboard (index.html and assets) for an unbundled production run. Default: dist/web.
# LITEROUTER_SPA_DIR=dist/web
# Hide the tunnel, Tailscale and MITM surfaces (minimal profile). Set to "true" in production.
# MINIMAL_PROFILE=true
# Set to "off" to disable the background model catalog sync; "true" turns off the background OAuth token refresh.
# MODEL_CATALOG_SYNC=off
# DISABLE_BACKGROUND_TOKEN_REFRESH=true
# Set to "true" to trust X-Real-IP / X-Forwarded-For for login throttling when no request context is available.
# TRUST_PROXY=true
# Set to DEBUG for verbose account-selection logging.
# LOG_LEVEL=DEBUG

# Optional Antigravity callback override. Default: localhost + manual paste.
# Use the dashboard's HTTPS /callback URL only if this exact URL is accepted
# by the Antigravity Google OAuth client. This does not bypass Google account
# verification or repair expired/reused authorization codes.
# ANTIGRAVITY_REDIRECT_URI=https://ai.example.com/callback

# Optional app timezone (IANA name). Drives usage day keys, "today" boundaries,
# chart hours and log times on the server, and the zone the dashboard displays.
# Default: the host/container zone (UTC in Docker). compose.production.yml maps
# LITEROUTER_TZ (default Asia/Jakarta) to TZ.
# TZ=Asia/Jakarta

# Recommended security and ops variables
# Also keys the client-key fingerprints (fp_...) stored in usage rows and request logs; changing it re-labels clients.
# This value is PUBLIC: replace it with a long random string (the server logs a loud warning otherwise).
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false

# Cache and invalidation bus. Optional: without REDIS_URL the process falls back to
# in-process caching. Never the source of providers, keys, usage, or settings —
# LiteRouter's durable state is the SQLite database under DATA_DIR.
# REDIS_URL=redis://idx-redis:6379
# REDIS_KEY_PREFIX=literouter:prod:

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional Google Analytics measurement ID (opt-in; unset = no third-party script)
# NEXT_PUBLIC_GA_ID=

# Kiro /v1/responses CreateResponse lane: auto (default) replays a turn there after a
# 429 USER_REQUEST_RATE_EXCEEDED, always uses it first, off disables it.
# LITEROUTER_KIRO_CREATE_RESPONSE=auto

# --- Reverse proxy / client IP trust -------------------------------------------------
# A request from a loopback socket counts as the "local operator" (keyless /v1, local-only
# routes) unless it carries a proxy marker: X-Forwarded-For/-Proto/-Host, X-Real-IP,
# Forwarded, Via, CF-Connecting-IP or True-Client-IP. Caddy sets X-Forwarded-*, so Caddy
# is classified remote. A proxy that sends NONE of these (e.g. bare nginx `proxy_pass`)
# would make every remote request look local: set this to false there.
TRUST_LOOPBACK_AS_LOCAL=true
# Largest request body Bun.serve accepts before answering 413 (default 128mb; units b, kb, mb, gb).
# NINEROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb
# Failed API-key attempts allowed per client IP per minute before a 60s 429 (default 20).
# API_KEY_FAIL_LIMIT=20
# Behind Caddy + Cloudflare the client IP the app sees is the rightmost X-Forwarded-For hop,
# which is a Cloudflare edge IP unless Caddy is told to trust Cloudflare. In the Caddyfile:
#   {
#     servers {
#       trusted_proxies cloudflare          # needs the caddy-cloudflare-ip module, or list the CF ranges
#       client_ip_headers CF-Connecting-IP
#     }
#   }
# Until then the throttle buckets all users behind one edge IP, hence the lenient default.
# Daily sync of Kenari's own model list (https://kenari.id/v1/models, public) into
# DATA_DIR/kenari-catalog.json: authoritative context/output limits and modalities for
# the kenari provider, plus its live /v1/models list. Fails open. Set to "off" to disable.
# KENARI_CATALOG_SYNC=off

# Optional pre-content failover and combo upstream health circuit breaker tuning (milliseconds / count).
# STREAM_PRE_CONTENT_TIMEOUT_MS=45000
# STREAM_PRE_CONTENT_TIMEOUT_FLASH_MS=20000
# UPSTREAM_HEALTH_WINDOW_MS=300000
# UPSTREAM_HEALTH_DEGRADE_BASE_MS=180000
# UPSTREAM_HEALTH_DEGRADE_MAX_MS=600000
# UPSTREAM_HEALTH_SLOW_TTFT_MS=25000
# UPSTREAM_HEALTH_STALL_THRESHOLD=2
