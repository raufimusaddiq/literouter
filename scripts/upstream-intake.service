[Unit]
Description=Daily disposable Codex upstream-intake review for LiteRouter
Documentation=file:/home/ubuntu/9router/scripts/upstream-intake.sh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/home/ubuntu/9router/scripts/upstream-intake.env
ExecStart=/home/ubuntu/9router/scripts/upstream-intake.sh
WorkingDirectory=/home/ubuntu/9router
StandardOutput=append:/var/log/upstream-intake.log
StandardError=append:/var/log/upstream-intake.log
TimeoutStartSec=130min
Restart=on-failure
RestartSec=5min
User=ubuntu
