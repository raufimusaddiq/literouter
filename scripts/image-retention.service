[Unit]
Description=Production image retention for LiteRouter
Documentation=file:/opt/9router/scripts/image-retention.sh
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/9router/scripts/image-retention.env
# systemd opens StandardOutput=append:/StandardError=append: BEFORE ExecStartPre
# (and before LogsDirectory= is created), so a unit that points them at a
# directory only the unit could have created fails at start with
# "Failed to set up standard output: No such file or directory" (status=209/STDOUT)
# and the timer silently never prunes. The shell therefore creates the directory
# and opens the log itself, in this unit's own process, and no append: directive
# targets that path. This keeps the log owned by the unit user instead of root,
# and leaves nothing for the install steps to pre-create.
ExecStart=/bin/sh -c 'mkdir -p /var/tmp/9router-image-retention && exec /opt/9router/scripts/image-retention.sh >>/var/tmp/9router-image-retention/retention.log 2>&1'
WorkingDirectory=/opt/9router
TimeoutStartSec=15min
User=ubuntu
