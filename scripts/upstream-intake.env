# Deployment tail for the daily upstream intake timer.
# false = stop after opening the PR (review only).
# true  = also wait CI + Hermes, merge to main, wait the production image, pull,
#         recreate `literouter`, and smoke https://ai.investdx.biz.id.
# Staging is sunset: this flow never targets or deploys staging.
# Authorized unattended intake: CI + current-head Hermes still gate deployment.
UPSTREAM_INTAKE_DEPLOY=true
# Repair attempts before a run stops and retains the workspace. Raise for more
# unattended persistence (each attempt must produce a new commit to continue).
# UPSTREAM_INTAKE_MAX_REPAIRS=10
# Clone retention: GC removes only clones idle this many days (min 2) whose work is
# provably published; bounded per run. See scripts/upstream-intake-retention.sh.
# UPSTREAM_INTAKE_RETAIN_DAYS=14
# UPSTREAM_INTAKE_GC_SCAN_MAX=50
# UPSTREAM_INTAKE_GC_DELETE_MAX=5
PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
