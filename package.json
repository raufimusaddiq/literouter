{
  "name": "literouter",
  "version": "0.5.81",
  "description": "Lean multi-provider AI routing gateway",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "gen:routes": "bun scripts/gen-route-table.mjs",
    "test": "cd tests && bun test --parallel",
    "predev": "node scripts/gen-provider-icon-manifest.mjs",
    "dev": "next dev --port 20127",
    "dev:webpack": "next dev --webpack --port 20127",
    "prebuild": "node scripts/gen-provider-icon-manifest.mjs",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "bun scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --port 20127",
    "prebuild:bun": "bun scripts/gen-provider-icon-manifest.mjs",
    "build:bun": "bun --bun next build",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/third-parties": "16.4.6",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.1.3",
    "material-symbols": "^0.44.6",
    "next": "16.4.6",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-musl": "16.4.6",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "better-sqlite3": "^12.6.2",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4"
  }
}
