{
  "name": "literouter",
  "version": "0.5.81",
  "description": "Lean multi-provider AI routing gateway",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "gen:routes": "bun scripts/gen-route-table.mjs",
    "test": "cd tests && bun test --parallel",
    "predev": "bun scripts/gen-provider-icon-manifest.mjs",
    "dev": "bun --hot src/server/index.js",
    "prebuild": "bun scripts/gen-provider-icon-manifest.mjs",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "postbuild": "bun scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "bun scripts/copy-standalone-assets.mjs",
    "start": "bun src/server/index.js",
    "prebuild:bun": "bun scripts/gen-provider-icon-manifest.mjs",
    "build:bun": "bun --bun next build",
    "build:web": "bun scripts/gen-provider-icon-manifest.mjs && bun scripts/build-web.mjs",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next/third-parties": "16.4.6",
    "@xyflow/react": "^12.10.1",
    "jose": "^6.1.3",
    "material-symbols": "^0.44.6",
    "next": "16.4.6",
    "node-machine-id": "^1.1.12",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-musl": "16.4.6",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "bun-plugin-tailwind": "^0.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4"
  }
}
