{
  "peer": "loopback",
  "auth": "apikey",
  "id": "zz-cache-06-defer-loading-tail",
  "method": "POST",
  "path": "/v1/messages",
  "json": {
    "model": "pa/claude-sonnet-5-5",
    "max_tokens": 1024,
    "stream": false,
    "system": [
      {
        "type": "text",
        "text": "You are a careful coding assistant. Follow the repository conventions."
      },
      {
        "type": "text",
        "text": "Prefer small, reviewable changes."
      }
    ],
    "tools": [
      {
        "name": "read_file",
        "description": "read_file tool",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        }
      },
      {
        "name": "grep_files",
        "description": "grep_files tool",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        }
      },
      {
        "name": "big_catalog_lookup",
        "description": "big_catalog_lookup tool",
        "input_schema": {
          "type": "object",
          "properties": {
            "q": {
              "type": "string"
            }
          },
          "required": [
            "q"
          ]
        },
        "defer_loading": true,
        "cache_control": {
          "type": "ephemeral",
          "ttl": "1h"
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Summarize the repository layout."
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "The repo has src, open-sse and tests."
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Which directory holds the executors?"
          }
        ]
      }
    ]
  },
  "headers": {
    "anthropic-version": "2023-06-01",
    "user-agent": "claude-cli/2.0.0 (external, cli)"
  }
}
